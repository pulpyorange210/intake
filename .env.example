# Copy to .env and fill in what you use. Everything is optional:
# without ANTHROPIC_API_KEY, uploads replay recorded runs (only the 50 synthetic forms are recorded);
# without the Google variables, approved rows go to data/sheet.csv;
# without SLACK_WEBHOOK_URL, alerts go to data/slack_outbox.jsonl.

ANTHROPIC_API_KEY=

# Service-account key JSON (the file's contents, or a path to it). Share the sheet with the account's email.
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=

# Slack incoming webhook (Slack app > Incoming Webhooks > Add New Webhook to Workspace)
SLACK_WEBHOOK_URL=

# Where the review UI runs; used for the "Review form" button in Slack alerts
REVIEW_UI_BASE_URL=http://localhost:5173

# Optional overrides
# INTAKE_DATA_DIR=data
# INTAKE_DB=data/intake.db
# INTAKE_CATALOG=synthetic_order_form_dataset_50/sku_catalog.json
# INTAKE_EXTRACTOR=replay   # or live
